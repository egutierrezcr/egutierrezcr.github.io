  </div>

<script src="/js/mis-hero.js" is:inline></script>
<script is:inline>
(function () {
  var base = {
    w: 520, h: 360,
    fantasma: [[150, 60, 206, 110, .5], [150, 300, 206, 250, .5]],
    enlaces: [[0, 3, .5], [1, 3, .5], [2, 3, .5], [3, 4, .5]]
  };
  function nodos(L) {
    return [
      { x: 14, y: 34, w: 126, h: 54, et: L[0], estado: 'activo', b1: .7, b2: .4 },
      { x: 14, y: 152, w: 126, h: 54, et: L[1], estado: 'activo', b1: .6, b2: .36 },
      { x: 14, y: 270, w: 126, h: 54, et: L[2], estado: 'espera', b1: .45, b2: .26 },
      { x: 206, y: 140, w: 146, h: 76, et: L[3], fuerte: true, estado: 'activo', b1: .85, b2: .55, pie: L[4] },
      { x: 400, y: 140, w: 112, h: 56, et: L[5], estado: 'espera', b1: .5, b2: .3 }
    ];
  }
  if (!window.MIS_HERO) return;
  MIS_HERO('#mis-hero-cont-en', Object.assign({}, base, {
    alt: 'Contact channels connected to one conversation',
    nodos: nodos(['PROFESSIONAL', 'COMMUNITY', 'NETWORK', 'CONVERSATION', '20 MINUTES', 'PROPOSAL'])
  }));
  MIS_HERO('#mis-hero-cont-es', Object.assign({}, base, {
    alt: 'Canales de contacto conectados a una conversación',
    nodos: nodos(['PROFESIONAL', 'COMUNITARIO', 'RED', 'CONVERSACIÓN', '20 MINUTOS', 'PROPUESTA'])
  }));
})();
</script>

