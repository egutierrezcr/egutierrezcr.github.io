        <a class="mis-nodo" href="tel:+50661427330"><i class="mis-pt"></i><span class="mis-et">Phone &middot; WhatsApp</span><h3>Direct line</h3><p>+506 6142-7330</p><div class="mis-barras"><i></i><i></i></div></a>
        <a class="mis-nodo" href="https://linkedin.com/in/emmanuelgpcr" target="_blank"><i class="mis-pt mis-esp"></i><span class="mis-et">LinkedIn</span><h3>Network</h3><p>/in/emmanuelgpcr</p><div class="mis-barras"><i></i><i></i></div></a>
