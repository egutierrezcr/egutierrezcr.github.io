---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function fmtDate(d: Date, locale: string) {
  return d.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Layout title={`${post.data.title_en} - Emmanuel Gutiérrez Pizarro`} description={post.data.summary_en}>

<div class="mis-page">
  <div class="mis-puntos"></div>

  <article class="mis-env post">
    <div class="lang-en">
      <header class="post-header">
        <div class="post-meta">
          <a href="/blog/" class="post-back">&larr; Back to blog</a>
        </div>
        <h1>{post.data.title_en}</h1>
        <div class="post-byline">
          <span>{fmtDate(post.data.date, 'en-US')}</span>
          {post.data.original_outlet && (
            <span> &middot; Originally in {post.data.original_outlet}</span>
          )}
        </div>
        {post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((t) => <span class="post-tag">{t}</span>)}
          </div>
        )}
      </header>
    </div>

    <div class="lang-es">
      <header class="post-header">
        <div class="post-meta">
          <a href="/blog/" class="post-back">&larr; Volver al blog</a>
        </div>
        <h1>{post.data.title_es}</h1>
        <div class="post-byline">
          <span>{fmtDate(post.data.date, 'es-CR')}</span>
          {post.data.original_outlet && (
            <span> &middot; Publicado originalmente en {post.data.original_outlet}</span>
          )}
        </div>
        {post.data.tags.length > 0 && (
          <div class="post-tags">
            {post.data.tags.map((t) => <span class="post-tag">{t}</span>)}
          </div>
        )}
      </header>
    </div>

    <div class="post-body">
      <Content />
    </div>

    {post.data.original_url && (
      <div class="post-original">
        <div class="lang-en">
          <a href={post.data.original_url} target="_blank" rel="noopener" class="mis-btn mis-fantasma">Read the original article{post.data.original_lang === 'es' ? ' (Spanish)' : ''} &#8599;</a>
        </div>
        <div class="lang-es">
          <a href={post.data.original_url} target="_blank" rel="noopener" class="mis-btn mis-fantasma">Leer el artículo original{post.data.original_lang === 'en' ? ' (inglés)' : ''} &#8599;</a>
        </div>
      </div>
    )}
  </article>
</div>

</Layout>

<style is:global>
  @import '../../styles/mis-personal.css';
</style>

<style>
  /* La lectura larga se centra y se estrecha: el resto del sitio usa 1120px,
     un articulo necesita ~720px para no cansar. */
  .post {
    max-width: 760px;
    padding-top: clamp(40px, 7vh, 72px);
    padding-bottom: clamp(48px, 9vh, 88px);
  }
  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--mis-linea);
  }
  .post-meta { margin-bottom: 1rem; }
  .post-back {
    font-family: var(--mis-mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--mis-navy2);
    text-decoration: none;
  }
  .post-back:hover { color: var(--mis-azul); }
  .post-header h1 {
    font-family: var(--mis-disp);
    font-weight: 700;
    font-size: clamp(28px, 4.4vw, 44px);
    letter-spacing: -.035em;
    line-height: 1.1;
    margin: 0.6rem 0 1rem 0;
    color: var(--mis-navy);
  }
  .post-byline {
    font-family: var(--mis-mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--mis-navy2);
    margin-bottom: 1rem;
  }
  .post-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .post-tag {
    background: var(--mis-panel);
    border: 1px solid var(--mis-linea);
    color: var(--mis-navy);
    font-family: var(--mis-mono);
    font-size: 10.5px;
    letter-spacing: .05em;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
  }
  .post-body {
    font-size: 17px;
    line-height: 1.75;
    color: var(--mis-navy);
  }
  .post-body :global(h2),
  .post-body :global(h3) {
    font-family: var(--mis-disp);
    font-weight: 700;
    letter-spacing: -.028em;
    line-height: 1.15;
    color: var(--mis-navy);
  }
  .post-body :global(h2) { font-size: clamp(21px, 2.8vw, 28px); margin: 2.4rem 0 0.8rem; }
  .post-body :global(h3) { font-size: clamp(18px, 2.2vw, 22px); margin: 1.9rem 0 0.6rem; }
  .post-body :global(p) { margin: 0 0 1.15rem 0; color: var(--mis-navy2); }
  .post-body :global(strong) { color: var(--mis-navy); font-weight: 600; }
  .post-body :global(ul),
  .post-body :global(ol) { margin: 0 0 1.15rem 1.3rem; color: var(--mis-navy2); }
  .post-body :global(li) { margin-bottom: 0.5rem; }
  .post-body :global(em) { color: var(--mis-navy2); }
  .post-body :global(blockquote) {
    border-left: 3px solid var(--mis-ambar);
    padding: 0.4rem 0 0.4rem 1.2rem;
    margin: 1.5rem 0;
    font-family: var(--mis-disp);
    font-weight: 500;
    font-style: normal;
    font-size: clamp(17px, 2.1vw, 20px);
    line-height: 1.45;
    letter-spacing: -.02em;
    color: var(--mis-navy);
  }
  .post-body :global(blockquote p) { color: var(--mis-navy); }
  .post-body :global(a) {
    color: var(--mis-azul);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-original {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--mis-linea);
  }
</style>
