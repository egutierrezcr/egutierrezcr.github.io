  <!-- ========== ENGLISH ========== -->
  <div class="lang-en">
  <div class="mis-page">
    <div class="mis-puntos"></div>

    <section class="mis-hero"><div class="mis-env">
      <div>
        <div class="mis-kick"><s></s><span>Territorial intelligence &middot; Costa Rica</span></div>
        <h1>I read territories, institutions and companies as <em>systems</em></h1>
        <p class="mis-lead">Data, fiscal evidence and tools that stay where they were built. Thirteen years alongside communities, social organizations and institutions in Central America.</p>
        <div class="mis-acciones">
          <a class="mis-btn" href="/proyectos">See the work</a>
          <a class="mis-btn mis-fantasma" href="https://myintelligentsystem.com" target="_blank">My Intelligent System &#8599;</a>
          <a class="mis-btn mis-fantasma" href="https://myintelligentsystem.com/tour/" target="_blank">Tour my 3D office &#8599;</a>
          <a class="mis-btn mis-fantasma" href="/contacto">Write to me &rarr;</a>
        </div>
      </div>
      <div class="mis-lienzo" id="mis-hero-en"></div>
    </div></section>

    <section class="mis-cifras"><div class="mis-env">
      <div class="mis-cifra"><b>USD 55M+</b><span>Documented annual fiscal gap</span></div>
