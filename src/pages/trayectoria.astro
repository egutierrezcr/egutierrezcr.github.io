        <div>
          <div class="mis-forma" style="grid-template-columns: minmax(0, 1fr);">
            <div class="mis-it"><h4>Idiomas</h4><span>Español e inglés</span></div>
            <div class="mis-it"><h4>Base</h4><span>Costa Rica</span></div>
            <div class="mis-it"><h4>Alcance</h4><span>Costa Rica y Centroamérica</span></div>
